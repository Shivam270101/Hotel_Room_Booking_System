@{
    ViewData["Title"] = "About Us";
}

<div class="container py-5" style="margin-top: 80px;">
    <!-- Hero Header -->
    <div class="row align-items-center mb-5">
        <div class="col-lg-6 mb-4 mb-lg-0">
            <h6 class="text-gold text-uppercase fw-bold letter-spacing-1">Our Heritage</h6>
            <h1 class="display-5 fw-bold mb-3">Redefining Hospitality at <span class="text-gold">Grand Horizon</span></h1>
            <p class="lead text-muted">
                Nestled in the prime city center, Grand Horizon Hotel has been delivering timeless luxury, exceptional dining, and heartfelt service since 2010.
            </p>
            <p class="text-muted">
                Every detail of our boutique property is thoughtfully curated—from custom handcrafted furnishings and plush bedding to our tranquil wellness spa and world-class culinary experiences. Whether you are traveling for business, a romantic retreat, or a memorable family vacation, we make your stay extraordinary.
            </p>
        </div>
        <div class="col-lg-6">
            <div class="p-4 bg-light rounded-4 shadow-sm border text-center">
                <i class="fas fa-hotel fa-5x text-gold mb-3"></i>
                <h4 class="fw-bold">A Five-Star Experience</h4>
                <p class="text-muted mb-0">Awarded "Best Boutique Luxury Hotel" 4 consecutive years.</p>
            </div>
        </div>
    </div>

    <!-- Core Values -->
    <div class="row g-4 text-center my-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 p-4">
                <div class="card-body">
                    <i class="fas fa-heart fa-3x text-gold mb-3"></i>
                    <h5 class="fw-bold">Genuine Hospitality</h5>
                    <p class="text-muted small">Our dedicated concierge and staff are attentive to your every need 24 hours a day.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 p-4">
                <div class="card-body">
                    <i class="fas fa-gem fa-3x text-gold mb-3"></i>
                    <h5 class="fw-bold">Bespoke Luxury</h5>
                    <p class="text-muted small">From Egyptian cotton sheets to marble bathrooms and artisanal toiletries, elegance is paramount.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 p-4">
                <div class="card-body">
                    <i class="fas fa-leaf fa-3x text-gold mb-3"></i>
                    <h5 class="fw-bold">Sustainable Comfort</h5>
                    <p class="text-muted small">We prioritize eco-friendly luxury with smart climate control and organic local ingredients.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Hotel Stats -->
    <div class="row g-4 text-center bg-dark text-white rounded-4 p-4 my-5">
        <div class="col-md-3 col-6">
            <h2 class="display-5 fw-bold text-gold">10+</h2>
            <p class="text-muted mb-0">Premium Rooms & Suites</p>
        </div>
        <div class="col-md-3 col-6">
            <h2 class="display-5 fw-bold text-gold">15k+</h2>
            <p class="text-muted mb-0">Delighted Guests</p>
        </div>
        <div class="col-md-3 col-6">
            <h2 class="display-5 fw-bold text-gold">4.9/5</h2>
            <p class="text-muted mb-0">Guest Satisfaction Rating</p>
        </div>
        <div class="col-md-3 col-6">
            <h2 class="display-5 fw-bold text-gold">24/7</h2>
            <p class="text-muted mb-0">Concierge & Room Service</p>
        </div>
    </div>
</div>
