@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5" style="margin-top: 80px;">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <h1 class="display-6 fw-bold mb-4">Privacy & Booking Policy</h1>
            <p class="text-muted">Last updated: November 2026</p>
            <hr class="mb-4">

            <section class="mb-4">
                <h4 class="fw-bold text-dark">1. Information We Collect</h4>
                <p class="text-muted">
                    When you reserve a room or create an account with Grand Horizon Hotel, we collect information necessary to process your booking, including your full name, email address, contact telephone number, stay dates, and special requests.
                </p>
            </section>

            <section class="mb-4">
                <h4 class="fw-bold text-dark">2. How We Use Your Data</h4>
                <p class="text-muted">
                    Your personal information is used exclusively to confirm room reservations, manage check-in/check-out services, communicate essential stay updates, and provide personalized guest hospitality. We never sell, lease, or share your data with third-party advertisers.
                </p>
            </section>

            <section class="mb-4">
                <h4 class="fw-bold text-dark">3. Cancellation & Refund Policy</h4>
                <p class="text-muted">
                    Guests can cancel reservations without penalty up to 24 hours prior to standard check-in time (2:00 PM). Cancellations can be performed directly through the <em>My Bookings</em> portal or by looking up your reservation reference.
                </p>
            </section>

            <section class="mb-4">
                <h4 class="fw-bold text-dark">4. Data Security</h4>
                <p class="text-muted">
                    We enforce strict security practices, including cryptographic hashing of user passwords via ASP.NET Core Identity, encrypted HTTPS transport, and role-based authorization restricting access to administrative functions.
                </p>
            </section>

            <div class="mt-5 p-4 bg-light rounded-3 border">
                <h5 class="fw-bold">Questions Regarding Our Policies?</h5>
                <p class="text-muted mb-0">Feel free to reach out to our privacy officer at <a href="mailto:privacy@grandhorizon.com" class="text-gold">privacy@grandhorizon.com</a>.</p>
            </div>
        </div>
    </div>
</div>
