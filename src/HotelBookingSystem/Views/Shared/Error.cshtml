@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5" style="margin-top: 80px;">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <i class="fas fa-exclamation-triangle text-warning fa-4x mb-4"></i>
            <h1 class="display-4">Oops!</h1>
            <p class="lead text-muted">An error occurred while processing your request.</p>
            @if (Model?.ShowRequestId ?? false)
            {
                <p class="small text-muted">Request ID: <code>@Model?.RequestId</code></p>
            }
            <a asp-controller="Home" asp-action="Index" class="btn btn-gold mt-3">
                <i class="fas fa-home me-2"></i>Back to Home
            </a>
        </div>
    </div>
</div>
