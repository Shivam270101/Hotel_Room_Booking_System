@model Room
@{
    ViewData["Title"] = "Edit Room " + Model.RoomNumber;
}

<div class="container py-4" style="margin-top: 80px;">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="Rooms">Rooms</a></li>
            <li class="breadcrumb-item active">Edit Room @Model.RoomNumber</li>
        </ol>
    </nav>

    <h2 class="fw-bold mb-4"><i class="fas fa-edit me-2 text-gold"></i>Edit Room @Model.RoomNumber</h2>

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="EditRoom" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewContext.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

                        <h5 class="fw-bold mb-3 border-bottom pb-2">Basic Information</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="RoomNumber" class="form-label fw-semibold"></label>
                                <input asp-for="RoomNumber" class="form-control" />
                                <span asp-validation-for="RoomNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="Name" class="form-label fw-semibold"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Type" class="form-label fw-semibold"></label>
                                <select asp-for="Type" asp-items="Html.GetEnumSelectList<RoomType>()" class="form-select"></select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="BedType" class="form-label fw-semibold"></label>
                                <select asp-for="BedType" asp-items="Html.GetEnumSelectList<BedType>()" class="form-select"></select>
                            </div>
                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold"></label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            </div>
                        </div>

                        <h5 class="fw-bold mb-3 border-bottom pb-2">Room Details</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="PricePerNight" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="PricePerNight" class="form-control" type="number" step="0.01" min="0" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MaxOccupancy" class="form-label fw-semibold"></label>
                                <input asp-for="MaxOccupancy" class="form-control" type="number" min="1" max="10" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="FloorNumber" class="form-label fw-semibold"></label>
                                <input asp-for="FloorNumber" class="form-control" type="number" min="1" max="50" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="SizeInSqFt" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <input asp-for="SizeInSqFt" class="form-control" type="number" min="100" />
                                    <span class="input-group-text">sq ft</span>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="ImageUrl" class="form-label fw-semibold"></label>
                                <input asp-for="ImageUrl" class="form-control" />
                            </div>
                        </div>

                        <h5 class="fw-bold mb-3 border-bottom pb-2">Amenities</h5>
                        <div class="mb-4">
                            <label asp-for="Amenities" class="form-label fw-semibold"></label>
                            <input asp-for="Amenities" class="form-control" />
                            <small class="text-muted">Separate amenities with commas</small>
                        </div>

                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label fw-semibold">Room is active and available for booking</label>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-gold px-4">
                                <i class="fas fa-save me-2"></i>Save Changes
                            </button>
                            <a asp-action="Rooms" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
