@model DashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4" style="margin-top: 80px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0"><i class="fas fa-tachometer-alt me-2 text-gold"></i>Dashboard</h2>
        <span class="text-muted">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm stat-card-admin bg-primary text-white">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-uppercase small opacity-75">Total Rooms</div>
                        <div class="display-6 fw-bold">@Model.ActiveRooms</div>
                        <small class="opacity-75">@Model.TotalRooms total (@(Model.TotalRooms - Model.ActiveRooms) inactive)</small>
                    </div>
                    <i class="fas fa-door-open fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm stat-card-admin bg-success text-white">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-uppercase small opacity-75">Total Bookings</div>
                        <div class="display-6 fw-bold">@Model.TotalBookings</div>
                        <small class="opacity-75">@Model.PendingBookings pending approval</small>
                    </div>
                    <i class="fas fa-calendar-check fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm stat-card-admin bg-info text-white">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-uppercase small opacity-75">Occupancy Rate</div>
                        <div class="display-6 fw-bold">@Model.OccupancyRate%</div>
                        <small class="opacity-75">@Model.CurrentlyOccupied rooms occupied</small>
                    </div>
                    <i class="fas fa-chart-pie fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm stat-card-admin bg-warning text-dark">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-uppercase small opacity-75">Monthly Revenue</div>
                        <div class="display-6 fw-bold">$@Model.MonthlyRevenue.ToString("N0")</div>
                        <small class="opacity-75">$@Model.TotalRevenue.ToString("N0") all-time</small>
                    </div>
                    <i class="fas fa-dollar-sign fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Today's Activity & Status Breakdown -->
    <div class="row g-3 mb-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-dark text-white py-3">
                    <h6 class="mb-0"><i class="fas fa-calendar-day me-2"></i>Today's Activity</h6>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded">
                        <div>
                            <i class="fas fa-sign-in-alt text-success me-2"></i>
                            <span>Check-Ins Today</span>
                        </div>
                        <span class="badge bg-success fs-6">@Model.TodayCheckIns</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded">
                        <div>
                            <i class="fas fa-sign-out-alt text-info me-2"></i>
                            <span>Check-Outs Today</span>
                        </div>
                        <span class="badge bg-info fs-6">@Model.TodayCheckOuts</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded">
                        <div>
                            <i class="fas fa-bed text-primary me-2"></i>
                            <span>Currently Occupied</span>
                        </div>
                        <span class="badge bg-primary fs-6">@Model.CurrentlyOccupied</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-dark text-white py-3">
                    <h6 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Booking Status Breakdown</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span><i class="fas fa-circle text-warning me-1"></i> Pending</span>
                            <strong>@Model.PendingBookings</strong>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-warning" style="width: @(Model.TotalBookings > 0 ? (double)Model.PendingBookings / Model.TotalBookings * 100 : 0)%"></div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span><i class="fas fa-circle text-success me-1"></i> Confirmed</span>
                            <strong>@Model.ConfirmedBookings</strong>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-success" style="width: @(Model.TotalBookings > 0 ? (double)Model.ConfirmedBookings / Model.TotalBookings * 100 : 0)%"></div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span><i class="fas fa-circle text-info me-1"></i> Checked In</span>
                            <strong>@Model.CheckedInBookings</strong>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-info" style="width: @(Model.TotalBookings > 0 ? (double)Model.CheckedInBookings / Model.TotalBookings * 100 : 0)%"></div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span><i class="fas fa-circle text-danger me-1"></i> Cancelled</span>
                            <strong>@Model.CancelledBookings</strong>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-danger" style="width: @(Model.TotalBookings > 0 ? (double)Model.CancelledBookings / Model.TotalBookings * 100 : 0)%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="fas fa-clock me-2"></i>Upcoming Check-Ins</h6>
                </div>
                <div class="card-body p-0">
                    @if (Model.UpcomingCheckIns.Any())
                    {
                        @foreach (var booking in Model.UpcomingCheckIns)
                        {
                            <div class="d-flex align-items-center p-3 border-bottom">
                                <div class="me-3 text-center" style="min-width: 50px;">
                                    <div class="text-gold fw-bold small">@booking.CheckInDate.ToString("MMM")</div>
                                    <div class="fs-5 fw-bold">@booking.CheckInDate.Day</div>
                                </div>
                                <div class="flex-grow-1">
                                    <strong class="d-block">@booking.GuestFullName</strong>
                                    <small class="text-muted">Room @booking.Room?.RoomNumber &middot; @booking.NumberOfNights nights</small>
                                </div>
                                <span class="badge @booking.StatusBadgeClass">@booking.Status</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="fas fa-calendar-times fa-2x mb-2"></i>
                            <p class="mb-0">No upcoming check-ins</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Bookings Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="fas fa-history me-2"></i>Recent Bookings</h6>
            <a asp-action="Bookings" class="btn btn-sm btn-outline-light">View All</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Reference</th>
                            <th>Guest</th>
                            <th>Room</th>
                            <th>Check-In</th>
                            <th>Check-Out</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model.RecentBookings)
                        {
                            <tr>
                                <td><strong class="small">@booking.BookingReference</strong></td>
                                <td>@booking.GuestFullName</td>
                                <td>@booking.Room?.RoomNumber - @booking.Room?.Name</td>
                                <td>@booking.CheckInDate.ToString("MMM dd, yyyy")</td>
                                <td>@booking.CheckOutDate.ToString("MMM dd, yyyy")</td>
                                <td class="fw-bold">$@booking.TotalPrice.ToString("N2")</td>
                                <td><span class="badge @booking.StatusBadgeClass">@booking.Status</span></td>
                                <td>
                                    <a asp-action="BookingDetails" asp-route-id="@booking.Id"
                                       class="btn btn-sm btn-outline-dark">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row g-3 mt-3">
        <div class="col-md-4">
            <a asp-action="Rooms" class="btn btn-outline-dark w-100 p-3">
                <i class="fas fa-door-open me-2"></i>Manage Rooms
            </a>
        </div>
        <div class="col-md-4">
            <a asp-action="Bookings" class="btn btn-outline-dark w-100 p-3">
                <i class="fas fa-calendar-check me-2"></i>Manage Bookings
            </a>
        </div>
        <div class="col-md-4">
            <a asp-action="CreateRoom" class="btn btn-gold w-100 p-3">
                <i class="fas fa-plus me-2"></i>Add New Room
            </a>
        </div>
    </div>
</div>
