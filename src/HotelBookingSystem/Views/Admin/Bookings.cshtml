@model AdminBookingListViewModel
@{
    ViewData["Title"] = "Manage Bookings";
}

<div class="container-fluid py-4" style="margin-top: 80px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0"><i class="fas fa-calendar-check me-2 text-gold"></i>Manage Bookings</h2>
    </div>

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Bookings" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <input type="text" class="form-control" name="search"
                           placeholder="Search by reference, name, email..."
                           value="@Model.SearchQuery" />
                </div>
                <div class="col-md-2">
                    <select class="form-select" name="status">
                        <option value="">All Status</option>
                        @foreach (BookingStatus status in Enum.GetValues(typeof(BookingStatus)))
                        {
                            <option value="@((int)status)" selected="@(Model.FilterStatus == status)">@status</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <input type="date" class="form-control" name="date"
                           value="@Model.FilterDate?.ToString("yyyy-MM-dd")"
                           placeholder="Filter by date" />
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-dark flex-grow-1"><i class="fas fa-filter me-1"></i>Filter</button>
                    <a asp-action="Bookings" class="btn btn-outline-secondary"><i class="fas fa-redo"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bookings Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Reference</th>
                            <th>Guest</th>
                            <th>Contact</th>
                            <th>Room</th>
                            <th>Check-In</th>
                            <th>Check-Out</th>
                            <th>Nights</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Booked On</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Bookings.Any())
                        {
                            @foreach (var booking in Model.Bookings)
                            {
                                <tr>
                                    <td><strong class="small">@booking.BookingReference</strong></td>
                                    <td>@booking.GuestFullName</td>
                                    <td>
                                        <small class="d-block text-muted">@booking.GuestEmail</small>
                                        <small class="d-block text-muted">@booking.GuestPhone</small>
                                    </td>
                                    <td>
                                        <strong>@booking.Room?.RoomNumber</strong>
                                        <small class="d-block text-muted">@booking.Room?.Name</small>
                                    </td>
                                    <td>@booking.CheckInDate.ToString("MMM dd, yyyy")</td>
                                    <td>@booking.CheckOutDate.ToString("MMM dd, yyyy")</td>
                                    <td class="text-center">@booking.NumberOfNights</td>
                                    <td class="fw-bold">$@booking.TotalPrice.ToString("N2")</td>
                                    <td><span class="badge @booking.StatusBadgeClass">@booking.Status</span></td>
                                    <td><small>@booking.BookingDate.ToString("MMM dd, yyyy")</small></td>
                                    <td class="text-end">
                                        <a asp-action="BookingDetails" asp-route-id="@booking.Id"
                                           class="btn btn-sm btn-outline-dark">
                                            <i class="fas fa-eye me-1"></i>Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="11" class="text-center py-4 text-muted">
                                    <i class="fas fa-search fa-2x mb-2 d-block"></i>
                                    No bookings found
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Bookings"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-search="@Model.SearchQuery"
                       asp-route-status="@((int?)Model.FilterStatus)">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Bookings"
                           asp-route-page="@i"
                           asp-route-search="@Model.SearchQuery"
                           asp-route-status="@((int?)Model.FilterStatus)">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Bookings"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-search="@Model.SearchQuery"
                       asp-route-status="@((int?)Model.FilterStatus)">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
